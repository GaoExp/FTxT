<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tooltip_bg"
    android:padding="12dp">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@color/bat_monitor_header"/>

        <TextView
            android:id="@+id/tooltipTitle"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/bat_monitor_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tooltipBody"
        android:textSize="12sp"
        android:textColor="@color/bat_monitor_label"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
