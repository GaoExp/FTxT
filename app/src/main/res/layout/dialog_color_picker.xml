<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:text="Pilih Warna"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <!-- Color Wheel -->
    <FrameLayout
        android:id="@+id/cp_wheelContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="8dp">

        <exp.ftxt.features.color_picker.TriangleColorPickerView
            android:id="@+id/cp_colorWheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <!-- Live Preview -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/cp_colorPreview"
            android:gravity="center"
            android:background="#FF7DFF"
            android:padding="20dp"
            android:text="..."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </FrameLayout>

    <!-- HEX + Edit -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/cp_hexValue"
            android:text="HEX: #FF7DFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:longClickable="true"/>

        <ImageButton
            android:id="@+id/cp_hexEditButton"
            android:src="@drawable/ic_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Edit HEX"
            android:padding="4dp"/>

    </LinearLayout>

    <!-- HSV + ARGB -->
    <TextView
        android:id="@+id/cp_hsvValue"
        android:text="HSV: 0°, 0%, 0%"
        android:textSize="13sp"
        android:textColor="#9E9E9E"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:longClickable="true"/>

    <TextView
        android:id="@+id/cp_rgbValue"
        android:text="ARGB: 255, 0, 0, 0"
        android:textSize="13sp"
        android:textColor="#9E9E9E"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:longClickable="true"/>

    <!-- Hue Slider -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:text="H:"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="24dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/cp_hueLabel"
            android:text="0°"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="40dp"
            android:layout_height="wrap_content"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:id="@+id/cp_hueGradientBg"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"/>

            <View
                android:id="@+id/cp_hueThumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/seekbar_thumb"/>

            <View
                android:id="@+id/cp_hueTouchArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Saturation Slider -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:text="S:"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="24dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/cp_saturationLabel"
            android:text="0%"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="40dp"
            android:layout_height="wrap_content"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:id="@+id/cp_saturationGradientBg"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"/>

            <View
                android:id="@+id/cp_saturationThumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/seekbar_thumb"/>

            <View
                android:id="@+id/cp_saturationTouchArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Value Slider -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:text="V:"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="24dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/valueLabel"
            android:text="0%"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="40dp"
            android:layout_height="wrap_content"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:id="@+id/valueGradientBg"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"/>

            <View
                android:id="@+id/valueThumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/seekbar_thumb"/>

            <View
                android:id="@+id/valueTouchArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Alpha Slider -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:text="A:"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="24dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/cp_alphaLabel"
            android:text="255"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="40dp"
            android:layout_height="wrap_content"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:id="@+id/cp_alphaGradientBg"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"/>

            <View
                android:id="@+id/cp_alphaThumb"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/seekbar_thumb"/>

            <View
                android:id="@+id/cp_alphaTouchArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

    </LinearLayout>

    <!-- RGB Sliders (collapsible) -->
    <LinearLayout
        android:id="@+id/rgbHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:text="Tampilkan slider RGB"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/rgbCollapseToggle"
            android:text="▼"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rgbSliderBody"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <!-- Red -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:text="R:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E53935"
                android:layout_width="24dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/redValLabel"
                android:text="255"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/redGradientBg"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"/>

                <View
                    android:id="@+id/redThumb"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/seekbar_thumb"/>

                <View
                    android:id="@+id/redTouchArea"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"/>

            </FrameLayout>

        </LinearLayout>

        <!-- Green -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:text="G:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#43A047"
                android:layout_width="24dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/greenValLabel"
                android:text="125"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/greenGradientBg"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"/>

                <View
                    android:id="@+id/greenThumb"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/seekbar_thumb"/>

                <View
                    android:id="@+id/greenTouchArea"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"/>

            </FrameLayout>

        </LinearLayout>

        <!-- Blue -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:text="B:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E88E5"
                android:layout_width="24dp"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/blueValLabel"
                android:text="255"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <View
                    android:id="@+id/blueGradientBg"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_gravity="center_vertical"/>

                <View
                    android:id="@+id/blueThumb"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/seekbar_thumb"/>

                <View
                    android:id="@+id/blueTouchArea"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"/>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Saved Colors Header -->
    <LinearLayout
        android:id="@+id/savedColorsHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/cp_addSavedColor"
            android:text="[tambah]"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:text="Preset Warna"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>

        <TextView
            android:id="@+id/cp_collapseToggle"
            android:text="▼"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/cp_savedColorsCount"
            android:text="0/16"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <GridLayout
        android:id="@+id/cp_savedColorsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:columnCount="8"
        android:rowCount="2"/>

    <!-- Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/cancelButton"
            android:text="Cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/okButton"
            android:text="OK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
