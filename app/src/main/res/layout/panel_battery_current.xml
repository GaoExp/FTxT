<?xml version="1.0" encoding="utf-8"?>
            <!-- Battery Current Panel -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/panel_battery_current"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="always"
                android:scrollbars="vertical"
                android:fillViewport="true">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/batCurSwitch"
                        android:text="Battery Current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/batCurLockSwitch"
                        android:text="Kunci Posisi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/batCur_sectionDisplayHeader"
                    android:text="▾ Tampilan"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/batCur_sectionDisplay"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/batCurSizeLabel"
                    android:text="Ukuran Teks: 24"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/batCurSizeSeekBar"
                    android:max="140"
                    android:progress="24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/batCurColorPreview"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="#FF0000"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:text="Warna"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/batCurLabelColorPreview"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="#00FF00"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:text="Label"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp">

                        <TextView
                            android:text="Update="
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/batCurIntervalValue"
                            android:text="1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:background="#555555"
                            android:textColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:minWidth="36dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="s"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <CheckBox
                        android:id="@+id/batCurShowVoltage"
                        android:text="mV"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/batCurShowCurrent"
                        android:text="mA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/batCurShowPower"
                        android:text="W"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/batCur_sectionPositionHeader"
                    android:text="▾ Posisi"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/batCur_sectionPosition"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <!-- Battery Current Position Controls -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Kontrol Posisi"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurPosCoordDisplay"
                        android:text="540X1200"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/batCurPosXLabel"
                            android:text="X: 0.50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <SeekBar
                            android:id="@+id/batCurPosXSeekBar"
                            android:max="1000"
                            android:progress="500"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/batCurPosYLabel"
                            android:text="Y: 0.50"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <SeekBar
                            android:id="@+id/batCurPosYSeekBar"
                            android:max="1000"
                            android:progress="500"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/batCurBtnUp"
                            android:text="↑"
                            android:layout_width="35dp"
                            android:layout_height="35dp"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/batCurBtnLeft"
                                android:text="←"
                                android:layout_width="35dp"
                                android:layout_height="35dp"/>

                            <Space
                                android:layout_width="60dp"
                                android:layout_height="0dp"/>

                            <Button
                                android:id="@+id/batCurBtnRight"
                                android:text="→"
                                android:layout_width="35dp"
                                android:layout_height="35dp"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/batCurBtnDown"
                            android:text="↓"
                            android:layout_width="35dp"
                            android:layout_height="35dp"/>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/batCurTxtActivePreset"
                    android:text="Aktif: -"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/batCurBtnSavePreset"
                        android:text="Simpan"
                        android:singleLine="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/batCurBtnLoadPreset"
                        android:text="Muat"
                        android:singleLine="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <CheckBox
                    android:id="@+id/batCurSafeArea"
                    android:text="Gunakan Area Aman"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/batCur_sectionShadowHeader"
                    android:text="▾ Shadow"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/batCur_sectionShadow"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <!-- Shadow -->
                <CheckBox
                    android:id="@+id/batCurShadowSwitch"
                    android:text="Shadow"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/shadowConfigBatteryCurrent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/batCurShadowColorButton"
                        android:text="Warna Shadow"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurShadowBlurLabel"
                        android:text="Blur Shadow: 5"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurShadowBlurSeekBar"
                        android:max="50"
                        android:progress="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurShadowOffsetXLabel"
                        android:text="Shadow X: 3"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurShadowOffsetXSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurShadowOffsetYLabel"
                        android:text="Shadow Y: 3"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurShadowOffsetYSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/batCur_sectionBackgroundHeader"
                    android:text="▾ Background"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/batCur_sectionBackground"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <!-- Background -->
                <CheckBox
                    android:id="@+id/batCurBgSwitch"
                    android:text="Background"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/bgConfigBatteryCurrent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/batCurBgColorButton"
                        android:text="Warna Background"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurBgPaddingLabel"
                        android:text="Ukuran Background: 8"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurBgPaddingSeekBar"
                        android:max="80"
                        android:progress="8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurBgOffsetXLabel"
                        android:text="Offset X: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurBgOffsetXSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurBgOffsetYLabel"
                        android:text="Offset Y: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurBgOffsetYSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurBgMarginLabel"
                        android:text="Margin: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurBgMarginSeekBar"
                        android:max="30"
                        android:progress="0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/batCurBgRadiusLabel"
                        android:text="Radius: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/batCurBgRadiusSeekBar"
                        android:max="50"
                        android:progress="0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            </LinearLayout>
