<?xml version="1.0" encoding="utf-8"?>
            <!-- FPS Panel -->
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/panel_fps"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="always"
                android:scrollbars="vertical"
                android:fillViewport="true">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/fpsSwitch"
                        android:text="FPS Overlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <CheckBox
                        android:id="@+id/fpsLockSwitch"
                        android:text="Kunci Posisi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/fps_sectionDisplayHeader"
                    android:text="▾ Tampilan"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/fps_sectionDisplay"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <CheckBox
                    android:id="@+id/fpsValueOnlyCheck"
                    android:text="Hanya Tampilkan Nilai"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/fpsSizeLabel"
                    android:text="Ukuran Teks: 14"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/fpsSizeSeekBar"
                    android:max="140"
                    android:progress="14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/fpsColorButton"
                    android:text="Pilih Warna"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/fpsLabelColorButton"
                    android:text="Warna Label"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/fpsIntervalMinus"
                        android:text="-"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/fpsIntervalLabel"
                        android:text="Update: 1s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/fpsIntervalPlus"
                        android:text="+"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"/>

                </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/fps_sectionPositionHeader"
                    android:text="▾ Posisi"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/fps_sectionPosition"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <!-- FPS Position Controls -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="Kontrol Posisi"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fps_posCoordDisplay"
                        android:text="540X1200"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/fps_posXLabel"
                            android:text="X: 0.50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <SeekBar
                            android:id="@+id/fps_posXSeekBar"
                            android:max="1000"
                            android:progress="500"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/fps_posYLabel"
                            android:text="Y: 0.50"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <SeekBar
                            android:id="@+id/fps_posYSeekBar"
                            android:max="1000"
                            android:progress="500"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/fps_btnUp"
                            android:text="↑"
                            android:layout_width="35dp"
                            android:layout_height="35dp"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <Button
                                android:id="@+id/fps_btnLeft"
                                android:text="←"
                                android:layout_width="35dp"
                                android:layout_height="35dp"/>

                            <Space
                                android:layout_width="60dp"
                                android:layout_height="0dp"/>

                            <Button
                                android:id="@+id/fps_btnRight"
                                android:text="→"
                                android:layout_width="35dp"
                                android:layout_height="35dp"/>

                        </LinearLayout>

                        <Button
                            android:id="@+id/fps_btnDown"
                            android:text="↓"
                            android:layout_width="35dp"
                            android:layout_height="35dp"/>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/fps_txtActivePreset"
                    android:text="Aktif: -"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/fps_btnSavePreset"
                        android:text="Simpan"
                        android:singleLine="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/fps_btnLoadPreset"
                        android:text="Muat"
                        android:singleLine="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

                <CheckBox
                    android:id="@+id/fpsSafeArea"
                    android:text="Gunakan Area Aman"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/fps_sectionShadowHeader"
                    android:text="▾ Shadow"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/fps_sectionShadow"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <CheckBox
                    android:id="@+id/fpsShadowSwitch"
                    android:text="Shadow"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/shadowConfigFps"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/fpsShadowColorButton"
                        android:text="Warna Shadow"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsShadowBlurLabel"
                        android:text="Blur Shadow: 5"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsShadowBlurSeekBar"
                        android:max="50"
                        android:progress="5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsShadowOffsetXLabel"
                        android:text="Shadow X: 3"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsShadowOffsetXSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsShadowOffsetYLabel"
                        android:text="Shadow Y: 3"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsShadowOffsetYSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_height="1dp"
                    android:background="#CCC"
                    android:layout_marginVertical="8dp"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/fps_sectionBackgroundHeader"
                    android:text="▾ Background"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/fps_sectionBackground"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <CheckBox
                    android:id="@+id/fpsBgSwitch"
                    android:text="Background"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/bgConfigFps"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/fpsBgColorButton"
                        android:text="Warna Background"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsBgPaddingLabel"
                        android:text="Ukuran Background: 10"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsBgPaddingSeekBar"
                        android:max="80"
                        android:progress="10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsBgOffsetXLabel"
                        android:text="Offset X: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsBgOffsetXSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsBgOffsetYLabel"
                        android:text="Offset Y: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsBgOffsetYSeekBar"
                        android:max="120"
                        android:progress="60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsBgMarginLabel"
                        android:text="Margin: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsBgMarginSeekBar"
                        android:max="30"
                        android:progress="0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/fpsBgRadiusLabel"
                        android:text="Radius: 0"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"/>

                    <SeekBar
                        android:id="@+id/fpsBgRadiusSeekBar"
                        android:max="50"
                        android:progress="0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            </LinearLayout>
