<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_debugging"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Debugging - Pilih Ikon Orientasi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ketuk ikon untuk melihat lebih jelas"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="24dp"/>

    <!-- Grid untuk menampilkan 5 variasi ikon -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:useDefaultMargins="true"
        android:alignmentMode="alignBounds">

        <!-- Variant 1: Material Icons standar -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">

            <ImageView
                android:id="@+id/icon_variant_1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_rotation_variant_1"
                android:contentDescription="Variant 1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Material Default"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Variant 2: Ponsel dengan panah -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">

            <ImageView
                android:id="@+id/icon_variant_2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_rotation_variant_2"
                android:contentDescription="Variant 2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Ponsel + Panah"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Variant 3: Tablet dengan panah -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">

            <ImageView
                android:id="@+id/icon_variant_3"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_rotation_variant_3"
                android:contentDescription="Variant 3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Tablet + Panah"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Variant 4: Panah sederhana -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">

            <ImageView
                android:id="@+id/icon_variant_4"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_rotation_variant_4"
                android:contentDescription="Variant 4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Panah Sederhana"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Variant 5: Lingkaran dengan P -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">

            <ImageView
                android:id="@+id/icon_variant_5"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_rotation_variant_5"
                android:contentDescription="Variant 5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Lingkaran + P"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </GridLayout>

    <!-- Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk ikon untuk preview, lalu beritahu saya mana yang ingin digunakan."
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:layout_marginTop="24dp"/>

</LinearLayout>
