<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/colorPreview"
        android:gravity="center"
        android:background="#FF7DFF"
        android:padding="24dp"
        android:text="Atomic Pink"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/hexValue"
            android:text="HEX: #FF7DFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:longClickable="true"/>

        <ImageButton
            android:id="@+id/hexEditButton"
            android:src="@drawable/ic_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Edit HEX"
            android:padding="4dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/hsvValue"
        android:text="HSV (300\u00B0, 50%, 100%)"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:longClickable="true"/>

    <TextView
        android:id="@+id/rgbValue"
        android:text="RGB (255, 125, 255)"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:longClickable="true"/>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/redLabel"
            android:text="R:255"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:layout_width="50dp"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/redSeekBar"
            android:max="255"
            android:progress="255"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/greenLabel"
            android:text="G:125"
            android:textStyle="bold"
            android:textColor="#43A047"
            android:layout_width="50dp"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/greenSeekBar"
            android:max="255"
            android:progress="125"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/blueLabel"
            android:text="B:255"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:layout_width="50dp"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/blueSeekBar"
            android:max="255"
            android:progress="255"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/alphaLabel"
            android:text="A:255"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_width="50dp"
            android:layout_height="wrap_content"/>

        <SeekBar
            android:id="@+id/alphaSeekBar"
            android:max="255"
            android:progress="255"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/okButton"
            android:text="OK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/cancelButton"
            android:text="Cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
