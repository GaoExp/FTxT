<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Text Panel -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_text"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Overlay + Kunci Posisi -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/overlaySwitch"
            android:text="Overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <CheckBox
            android:id="@+id/touchPassthroughSwitch"
            android:text="Kunci Posisi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <TextView
        android:id="@+id/text_sectionDisplayHeader"
        android:text="▾ Tampilan"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionDisplay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <EditText
        android:id="@+id/editText"
        android:hint="Masukkan teks overlay"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/textSizeLabel"
        android:text="Ukuran Teks: 20"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"/>

    <SeekBar
        android:id="@+id/textSizeSeekBar"
        android:max="150"
        android:progress="20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/colorButton"
        android:text="Pilih Warna"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionPositionHeader"
        android:text="▾ Posisi"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionPosition"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Kontrol Posisi -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:text="Kontrol Posisi"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/posCoordDisplay"
            android:text="540X1200"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/posXLabel"
                android:text="X: 0.50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/posXSeekBar"
                android:max="1000"
                android:progress="500"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/posYLabel"
                android:text="Y: 0.50"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/posYSeekBar"
                android:max="1000"
                android:progress="500"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnUp"
                android:text="↑"
                android:layout_width="35dp"
                android:layout_height="35dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnLeft"
                    android:text="←"
                    android:layout_width="35dp"
                    android:layout_height="35dp"/>

                <Space
                    android:layout_width="60dp"
                    android:layout_height="0dp"/>

                <Button
                    android:id="@+id/btnRight"
                    android:text="→"
                    android:layout_width="35dp"
                    android:layout_height="35dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnDown"
                android:text="↓"
                android:layout_width="35dp"
                android:layout_height="35dp"/>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txtActivePreset"
        android:text="Aktif: -"
        android:textSize="12sp"
        android:textColor="#999999"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnSavePreset"
            android:text="Simpan"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnLoadPreset"
            android:text="Muat"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <CheckBox
        android:id="@+id/textSafeArea"
        android:text="Gunakan Area Aman"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionShadowHeader"
        android:text="▾ Shadow"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionShadow"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/shadowSwitch"
        android:text="Shadow"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/shadowConfigText"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/shadowColorButton"
            android:text="Warna Shadow"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/shadowBlurLabel"
            android:text="Blur Shadow: 5"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowBlurSeekBar"
            android:max="50"
            android:progress="5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/shadowOffsetXLabel"
            android:text="Shadow X: 3"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowOffsetXSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/shadowOffsetYLabel"
            android:text="Shadow Y: 3"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowOffsetYSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionBackgroundHeader"
        android:text="▾ Background"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionBackground"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/bgSwitch"
        android:text="Background"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/bgConfigText"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/bgColorButton"
            android:text="Warna Background"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgPaddingLabel"
            android:text="Ukuran Background: 25"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgPaddingSeekBar"
            android:max="80"
            android:progress="25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgOffsetXLabel"
            android:text="Offset X: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgOffsetXSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgOffsetYLabel"
            android:text="Offset Y: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgOffsetYSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgMarginLabel"
            android:text="Margin: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgMarginSeekBar"
            android:max="30"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgRadiusLabel"
            android:text="Radius: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgRadiusSeekBar"
            android:max="50"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>

</LinearLayout>
