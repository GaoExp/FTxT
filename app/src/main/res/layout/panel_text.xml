<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Text Panel -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_text"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Overlay + Mode Segel + Kunci Posisi -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/overlaySwitch"
            android:text="Overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <CheckBox
            android:id="@+id/textPatternSwitch"
            android:text="Mode Segel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <CheckBox
            android:id="@+id/touchPassthroughSwitch"
            android:text="Kunci Posisi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <TextView
        android:id="@+id/text_sectionDisplayHeader"
        android:text="▾ Tampilan"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionDisplay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <EditText
        android:id="@+id/editText"
        android:hint="Masukkan teks overlay"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/textSizeLabel"
        android:text="Ukuran Teks: 20"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"/>

    <SeekBar
        android:id="@+id/textSizeSeekBar"
        android:max="150"
        android:progress="20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/colorPreview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FF0000"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:text="Warna"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/shadowColorPreview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FF0000"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:text="Shadow"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/bgColorPreview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FF0000"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:text="Background"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionPositionHeader"
        android:text="▾ Posisi"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionPosition"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Position Controls Container (hidden in pattern mode) -->
    <LinearLayout
        android:id="@+id/textPositionContainer"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Kontrol Posisi -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:text="Kontrol Posisi"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/posCoordDisplay"
            android:text="540X1200"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/posXLabel"
                android:text="X: 0.50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/posXSeekBar"
                android:max="1000"
                android:progress="500"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/posYLabel"
                android:text="Y: 0.50"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/posYSeekBar"
                android:max="1000"
                android:progress="500"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnUp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_arrow_up"
                android:contentDescription="@null"
                android:scaleType="centerInside"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"/>

                <Space
                    android:layout_width="60dp"
                    android:layout_height="0dp"/>

                <ImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDown"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="@null"
                android:scaleType="centerInside"/>

        </LinearLayout>

    </LinearLayout>



    <CheckBox
        android:id="@+id/textSafeArea"
        android:text="Gunakan Area Aman"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/textPatternContainer"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textPatternSpacingHLabel"
            android:text="Spasi Horizontal: 180"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/textPatternSpacingH"
            android:max="500"
            android:progress="180"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/textPatternSpacingVLabel"
            android:text="Spasi Vertikal: 220"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/textPatternSpacingV"
            android:max="500"
            android:progress="220"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/textPatternAngleLabel"
            android:text="Sudut: -30\u00B0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/textPatternAngle"
            android:max="360"
            android:progress="150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionShadowHeader"
        android:text="▾ Shadow"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionShadow"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/shadowSwitch"
        android:text="Shadow"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/shadowConfigText"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/shadowBlurLabel"
            android:text="Blur Shadow: 5"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowBlurSeekBar"
            android:max="50"
            android:progress="5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/shadowOffsetXLabel"
            android:text="Shadow X: 3"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowOffsetXSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/shadowOffsetYLabel"
            android:text="Shadow Y: 3"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/shadowOffsetYSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </LinearLayout>

    <View
        android:layout_height="1dp"
        android:background="#CCC"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/text_sectionBackgroundHeader"
        android:text="▾ Background"
        android:textStyle="bold"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/text_sectionBackground"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/bgSwitch"
        android:text="Background"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/bgConfigText"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/bgPaddingLabel"
            android:text="Ukuran Background: 25"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgPaddingSeekBar"
            android:max="80"
            android:progress="25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgOffsetXLabel"
            android:text="Offset X: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgOffsetXSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgOffsetYLabel"
            android:text="Offset Y: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgOffsetYSeekBar"
            android:max="120"
            android:progress="60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgMarginLabel"
            android:text="Margin: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgMarginSeekBar"
            android:max="30"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/bgRadiusLabel"
            android:text="Radius: 0"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"/>

        <SeekBar
            android:id="@+id/bgRadiusSeekBar"
            android:max="50"
            android:progress="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>

</LinearLayout>
