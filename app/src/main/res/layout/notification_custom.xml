<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/noti_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FTxT"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:textColor="@android:color/white" />

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/noti_toggle_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle"
            android:padding="8dp"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/noti_close_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kill"
            android:padding="8dp"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/noti_open_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open"
            android:padding="8dp"
            android:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
