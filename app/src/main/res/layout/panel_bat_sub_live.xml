<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/batSubLiveScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/batSubLivePanel"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/bat_card_bg"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/batLiveStatusText"
                                android:text="SESI BERJALAN"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/bat_monitor_header"
                                android:gravity="start"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/batLiveBadge"
                                android:text="● MONITORING"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/bat_monitor_label"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:background="@drawable/bat_badge_stopped_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <exp.ftxt.features.battery_stats.BatteryRingView
                                android:id="@+id/batLiveRing"
                                android:layout_width="100dp"
                                android:layout_height="100dp"/>

                            <LinearLayout
                                android:orientation="vertical"
                                android:gravity="center_vertical"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp">

                                <TextView
                                    android:id="@+id/batLiveStatusSub"
                                    android:text="—"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bat_monitor_header"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:id="@+id/batLiveStatusDetail"
                                    android:text="—"
                                    android:textSize="11sp"
                                    android:textColor="@color/bat_monitor_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="2dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/batLiveEstSection"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone">

                            <TextView
                                android:text="Perkiraan masa pakai"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/bat_monitor_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"/>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <View
                                    android:id="@+id/batLiveEstOnDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/bat_chart_power"/>

                                <TextView
                                    android:text="Layar hidup"
                                    android:textSize="11sp"
                                    android:textColor="@color/bat_monitor_label"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"/>

                                <TextView
                                    android:id="@+id/batLiveEstOn"
                                    android:text="—"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bat_monitor_header"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <View
                                    android:id="@+id/batLiveEstOffDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/bat_chart_current"/>

                                <TextView
                                    android:text="Layar mati"
                                    android:textSize="11sp"
                                    android:textColor="@color/bat_monitor_label"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"/>

                                <TextView
                                    android:id="@+id/batLiveEstOff"
                                    android:text="—"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bat_chart_current"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">

                                <View
                                    android:id="@+id/batLiveEstBothDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/bat_chart_voltage"/>

                                <TextView
                                    android:text="Kombinasi"
                                    android:textSize="11sp"
                                    android:textColor="@color/bat_monitor_label"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"/>

                                <TextView
                                    android:id="@+id/batLiveEstBoth"
                                    android:text="—"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bat_chart_voltage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/batLiveContent"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
</androidx.core.widget.NestedScrollView>
