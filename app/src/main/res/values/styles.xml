<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="SettingsPopupAnimation" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/settings_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/settings_popup_exit</item>
    </style>

    <style name="SettingsPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupAnimationStyle">@style/SettingsPopupAnimation</item>
    </style>

    <style name="TooltipFadeAnimation" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/tooltip_fade_in</item>
        <item name="android:windowExitAnimation">@anim/tooltip_fade_out</item>
    </style>

    <style name="BatNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="BatNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="MemNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="MemNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
    </style>

</resources>

